# --- Server ---
PORT=3000
LOG_LEVEL=info
# Shared secret required in the `x-override-token` header for manual override
# endpoints. Generate with: openssl rand -hex 32
OVERRIDE_TOKEN=change-me

# --- Control loop ---
POLL_INTERVAL_MS=30000
# Minimum continuous surplus (watts) required before we start a charge session
MIN_SURPLUS_START_W=1400
# Surplus (watts) below which we stop charging (hysteresis so we don't
# start/stop every poll cycle)
MIN_SURPLUS_STOP_W=200
# Reserve some solar for household loads / buffer before offering it to the car
GRID_IMPORT_BUFFER_W=150
# Tesla charging is quantized in amps (1A steps on most chargers). Assumed
# line voltage used to convert watts -> amps.
CHARGER_VOLTAGE=240
CHARGER_PHASES=1
MIN_CHARGE_AMPS=5
MAX_CHARGE_AMPS=32
# Consecutive polls a condition must hold before we act, to smooth out
# clouds passing over / momentary load spikes
STABLE_CYCLES_TO_START=2
STABLE_CYCLES_TO_STOP=3

# --- GoodWe SEMS cloud portal ---
# Personal inverters are almost always registered against the SEMS cloud
# portal (https://www.semsportal.com). We poll it for PV / load / grid power.
GOODWE_SEMS_ACCOUNT=you@example.com
GOODWE_SEMS_PASSWORD=your-sems-password
GOODWE_STATION_ID=your-power-station-id
GOODWE_SEMS_BASE_URL=https://eu.semsportal.com/api

# --- Tesla Fleet API (via local signed-command proxy) ---
# Run Tesla's open-source `tesla-http-proxy` locally/nearby - it holds your
# vehicle command signing key and forwards to Tesla's Fleet API. This app
# never talks to Tesla directly and never sees your private key.
TESLA_PROXY_URL=https://localhost:4443
TESLA_ACCESS_TOKEN=your-fleet-api-oauth-access-token
TESLA_VEHICLE_TAG=your-vehicle-id-or-vin
# Path to the proxy's CA cert if it uses a self-signed cert
TESLA_PROXY_CA_PATH=
