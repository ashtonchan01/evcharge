# --- Server ---
PORT=3000
LOG_LEVEL=info

# --- Control loop ---
POLL_INTERVAL_MS=30000
# Minimum continuous surplus (watts) required before we start a charge session
MIN_SURPLUS_START_W=1400
# Surplus (watts) below which we stop charging (hysteresis so we don't
# start/stop every poll cycle)
MIN_SURPLUS_STOP_W=200
# Grid import buffer (watts reserved for the house before offering solar to
# the car) is set live from the dashboard, not here - starts at 0 on boot.
# Tesla charging is quantized in amps (1A steps on most chargers). Assumed
# line voltage used to convert watts -> amps.
CHARGER_VOLTAGE=240
CHARGER_PHASES=1
MIN_CHARGE_AMPS=5
MAX_CHARGE_AMPS=32
# Consecutive polls a condition must hold before we act, to smooth out
# clouds passing over / momentary load spikes
STABLE_CYCLES_TO_START=2
STABLE_CYCLES_TO_STOP=3

# --- GoodWe SEMS cloud portal ---
# Personal inverters are almost always registered against the SEMS cloud
# portal (https://www.semsportal.com). We poll it for PV / load / grid power.
GOODWE_SEMS_ACCOUNT=you@example.com
GOODWE_SEMS_PASSWORD=your-sems-password
GOODWE_STATION_ID=your-power-station-id
GOODWE_SEMS_BASE_URL=https://www.semsportal.com/api

# --- Tesla Fleet API ---
# Region-specific Fleet API base URL, from your Tesla developer app config.
TESLA_FLEET_API_BASE_URL=https://fleet-api.prd.na.vehicle-command.psf.tesla.com
TESLA_CLIENT_ID=your-developer-app-client-id
TESLA_CLIENT_SECRET=your-developer-app-client-secret
# Long-lived refresh token from the OAuth authorization-code exchange;
# the app uses it to mint short-lived access tokens automatically.
TESLA_REFRESH_TOKEN=your-oauth-refresh-token
# Vehicle id/VIN to control. GET /api/vehicles lists every vehicle on
# your account so you can copy the right id.
TESLA_VEHICLE_TAG=your-vehicle-id-or-vin
# Optional. Only pre-2021 Model S/X are exempt from Tesla's signed
# "vehicle command protocol" - every other vehicle needs commands
# (start/stop charging, set amps; reads still work without this) routed
# through a local tesla-http-proxy instance. Leave unset if your target
# vehicle is an exempt pre-2021 S/X.
TESLA_COMMAND_PROXY_URL=https://localhost:4443
